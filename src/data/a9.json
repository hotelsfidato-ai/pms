            "dur": 6.241
          }
        },
        {
          "shot": "A9-28",
          "focus": 6,
          "line": {
            "text": "Tap Record the delivery.",
            "voice": "a9/voice/A9-09/16.wav",
            "dur": 1.678
          }
        },
        {
          "shot": "A9-29",
          "focus": 1,
          "line": {
            "text": "The order is delivered.",
