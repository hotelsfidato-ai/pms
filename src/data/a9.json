      },
      "record": null,
      "scenes": [
        {
          "shot": "A9-25",
          "focus": 1,
          "line": {
            "text": "Approved, the request is ready to order.",
            "voice": "a9/voice/A9-09/02.wav",
            "dur": 2.63
          }
        },
        {
          "shot": "A9-25",
          "focus": 2,
          "line": {
            "text": "It shows who decided.",
            "voice": "a9/voice/A9-09/03.wav",
            "dur": 1.666
          }
        },
        {
          "shot": "A9-25",
          "focus": 4,
          "line": {
            "text": "Every line needs an agreed price. Then tap Send the order.",
            "voice": "a9/voice/A9-09/04.wav",
            "dur": 4.204
          }
        },
        {
          "shot": "A9-26",
          "focus": 1,
          "line": {
            "text": "Choose the supplier to order it from.",
            "voice": "a9/voice/A9-09/05.wav",
            "dur": 2.259
          }
        },
        {
          "shot": "A9-26",
          "focus": 2,
          "line": {
            "text": "This records the order and makes it a PDF. It is sent by hand: printed, or attached to a message. Nothing is sent automatically.",
            "voice": "a9/voice/A9-09/06.wav",
            "dur": 8.413
          }
        },
        {
          "shot": "A9-26",
          "focus": 3,
          "line": {
            "text": "Tap Send the order.",
            "voice": "a9/voice/A9-09/07.wav",
            "dur": 1.457
          }
        },
        {
          "shot": "A9-27",
          "focus": 1,
          "line": {
            "text": "Its state is now Ordered.",
            "voice": "a9/voice/A9-09/08.wav",
            "dur": 1.864
          }
        },
        {
          "shot": "A9-27",
          "focus": 3,
          "line": {
            "text": "Download the order, and print it, or send it to the supplier.",
            "voice": "a9/voice/A9-09/09.wav",
            "dur": 3.617
          }
        },
        {
          "shot": "A9-27",
          "focus": 4,
          "line": {
            "text": "When the goods come, tap Record the delivery.",
            "voice": "a9/voice/A9-09/10.wav",
            "dur": 2.723
          }
        },
        {
          "shot": "A9-28",
          "focus": 1,
          "line": {
            "text": "Type what came.",
            "voice": "a9/voice/A9-09/11.wav",
            "dur": 1.388
          }
        },
        {
          "shot": "A9-28",
          "focus": 2,
          "line": {
            "text": "What it cost each, before GST.",
            "voice": "a9/voice/A9-09/12.wav",
            "dur": 2.816
          }
        },
        {
          "shot": "A9-28",
          "focus": 3,
          "line": {
            "text": "The bill's GST rate.",
            "voice": "a9/voice/A9-09/13.wav",
            "dur": 1.875
          }
        },
        {
          "shot": "A9-28",
          "focus": 4,
          "line": {
            "text": "And whether that GST can be claimed.",
            "voice": "a9/voice/A9-09/14.wav",
            "dur": 2.375
          }
        },
        {
          "shot": "A9-28",
          "focus": 5,
          "line": {
            "text": "Note anything about the delivery: a short delivery, a damaged case, a different brand.",
