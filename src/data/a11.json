        {
          "shot": "A11-20",
          "focus": null,
          "line": {
            "text": "They cover closing stock, movement by day, consumption, wastage and breakage, count differences, dead stock, days of cover, supplier spend, and the equipment.",
            "voice": "a11/voice/A11-09/06.wav",
            "dur": 10.873
