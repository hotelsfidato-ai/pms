# ─────────────────────────────────────────────────────────────────
# The App API — copy to .env and fill in.
# ─────────────────────────────────────────────────────────────────

# pms_app owns ROWS and nothing else. Connecting as pms_migrate or
# postgres bypasses RLS and makes every isolation guarantee in the
# schema decorative. The health check fails loudly if this is wrong.
DATABASE_URL=postgres://pms_app:CHANGE_ME_app@127.0.0.1:55432/fidato

# Database connections this API may hold; 20 when unset (D27-278). With
# several customers' APIs on one server, their pools (plus one each for
# live orders) must fit Postgres's max_connections (100 unless raised).
# DB_POOL_MAX=20

PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# The Firebase service account, as one line of JSON. THIS IS A SECRET,
# unlike the web config in src/lib/firebase.ts. Never commit it.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Development only: the x-dev-staff-id header names the caller, so the
# API can be exercised without a service account. The process REFUSES
# TO START with this set and NODE_ENV=production.
ALLOW_DEV_AUTH=1

# A connection that is NOT subject to row level security, used only by the
# operator tools (preflight, link-staff). They read `hotels` and `staff`
# directly; as `pms_app` with no session set, RLS hands them zero rows and
# every check passes on an empty result. On a deployed box this is the local
# postgres socket:
#
#   ADMIN_DATABASE_URL=postgres://postgres@/fidato?host=/var/run/postgresql
#
# The API server itself must NEVER use this.
ADMIN_DATABASE_URL=

# Where uploaded bills are kept. Must NOT be inside the git checkout —
# a deploy that re-clones would take the hotel's invoices with it.
UPLOAD_DIR=

# Optional: n8n copies each bill into Google Drive and posts the link back.
# Nothing breaks when this is unset — the file simply lives only here.
N8N_ATTACHMENT_WEBHOOK=

# ── Sending: the PMS → the CRS's n8n workflow (D17-87, D27-98, D27-186) ──
# ALL THREE must be set or nothing sends at all: no screen offers to send, and
# no row is written. That is the state the system ships in, deliberately - a
# record of what was never attempted is a log of the system's own unfinished
# state, not of anything anybody did.
#
#   CRS_N8N_URL / CRS_N8N_SECRET   the CRS's n8n, workflow deploy/n8n/pms-send-crs.json:
#                                  EVERY guest message - every email, and on
#                                  WhatsApp the voucher, the check-in code, the
#                                  check-in link, the stay reminder and the
#                                  review request
#   WHATSAPP_PHONE_NUMBER_ID       the one WhatsApp number they go from (D27-101):
#                                  its Meta Phone number ID, sent in every WhatsApp
#
#   GUEST_MESSAGES_PER_MINUTE      THE OWNER'S PACE (D21-34): how many booking
#                                  confirmations and reminders the sweep may send
#                                  a minute, soonest arrival first - the number
#                                  the WhatsApp account allows. NO DEFAULT: empty,
#                                  the sweep sends nothing at all (the desk's own
#                                  buttons still send). A whole number above 0.
#
#   M2R_N8N_URL / M2R_N8N_SECRET   NOT USED FOR NOW (D27-186): leave both empty.
#                                  Set, the market-to-revenue n8n
#                                  (deploy/n8n/pms-send-m2r.json) is told before
#                                  each WhatsApp that the guest is booked
#                                  (D27-104). Empty, that step is skipped.
#
#   The URL is the workflow's PRODUCTION url, not the Test url, and the
#   workflow must be ACTIVE. The secret is the long random text the
#   workflow's webhook checks, sent as `x-fidato-secret`.
#   ⚠ The OWNER makes it and it lives only here. Never in the repository,
#     a screen, a test or a chat. Neither is the n8n encryption key - that
#     one is a master password and is never pasted anywhere at all.
#
# The steps are deploy/n8n/IMPORT.md.
CRS_N8N_URL=
CRS_N8N_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
GUEST_MESSAGES_PER_MINUTE=
M2R_N8N_URL=
M2R_N8N_SECRET=

# ── The CRS bridge: reading the CRS's bookings (D27-168, D27-284) ───────
# The CRS's Firebase project and the read-only "automation" login the owner
# made in it. ALL FOUR or nothing is read. Each hotel also needs its card on
# Bookings → CRS bookings and an account to read as (deploy/crs-run-as.sql).
# The steps: deploy/README.md, "Connect the CRS".
#
#   CRS_PROJECT_ID / CRS_API_KEY   the CRS's Project ID and Web API key
#   CRS_AUTOMATION_EMAIL / _PASSWORD   the login; the password is a secret
#
# The hotel's answer, written back to the CRS's Register by its n8n
# (deploy/n8n/crs-pms-answer.json; OWNER-STEPS.md part 3). Empty: answers
# wait, and every one owed goes on the first read after both are set.
#
#   CRS_ANSWER_N8N_URL / CRS_ANSWER_N8N_SECRET
CRS_PROJECT_ID=
CRS_API_KEY=
CRS_AUTOMATION_EMAIL=
CRS_AUTOMATION_PASSWORD=
CRS_ANSWER_N8N_URL=
CRS_ANSWER_N8N_SECRET=

# ── The channel manager, SU (D17-66) ────────────────────────────────────
# The owner sets these ON THE SERVER only. They are keys to every booking
# site the group sells on: never in the repository, a screen, a test or a
# chat. Unset, the channel manager simply says it is not set up yet.
#
#   SU_ENVIRONMENT    sandbox (SU's test account) or live
#   SU_CLIENT_ID      from SU when the account is made
#   SU_CLIENT_SECRET  generated on SU's extranet
#   SU_PUSH_KEY       a long random text the OWNER makes, given to SU so it
#                     can push bookings here (D17-79). SU presents it on
#                     every push; anything else is refused with 401.
SU_ENVIRONMENT=
SU_CLIENT_ID=
SU_CLIENT_SECRET=
SU_PUSH_KEY=

# ── The leads app, read only (D27-100, D27-103, D27-170) ─────────────────
# The market-to-revenue app's leads, conversations and ad spend, read LIVE
# when a screen opens; nothing is copied here. Unset, the Leads and WhatsApp
# screen says it is not connected and nothing is read. The steps that make
# the login are src/modules/leads/OWNER-STEPS.md.
#
#   M2R_IMPERSONATE      the read-only login's EMAIL (not a secret):
#                        pms-reader@live-inventory1.iam.gserviceaccount.com.
#                        KEYLESS (D27-186): Google's organisation rule forbids
#                        a key for it, so this server's own Google login
#                        (FIREBASE_SERVICE_ACCOUNT) borrows an hour's token as
#                        it. Its one role is Cloud Datastore Viewer.
#   M2R_SERVICE_ACCOUNT  only if a key is ever allowed: that login's JSON key,
#                        ONE LINE. ⚠ A SECRET: on the server only. Used
#                        first when set. Leave empty otherwise.
#   M2R_HOTELS           which PMS hotel is which hotel in the app (comma
#                        between pairs):
#                        AMR=amrapali-kolhapur,GLM=grand-lucent-mathura
#   M2R_DAILY_READS      the most read in a day, counted from midnight Pacific
#                        (the owner's 5,000, D27-170). The app's free plan is
#                        50,000 a day, SHARED with the app itself.
#   M2R_APP_URL          the app's address, for "Reply in the leads app"
#
#   M2R_EMULATOR         THIS MACHINE ONLY: a stand-in for Google with made-up
#                        leads (the tests, and opening the screens). The server
#                        refuses it under NODE_ENV=production.
M2R_IMPERSONATE=
M2R_SERVICE_ACCOUNT=
M2R_HOTELS=
M2R_DAILY_READS=
M2R_APP_URL=

# ── Online check-in: Continue with Google (D27-207) ─────────────────────
# The guest's own page offers "Continue with Google" only when this is set:
# the OAuth client ID of the web client the owner makes in Google Cloud
# (src/modules/online-checkin/OWNER-STEPS.md). NOT a secret - it names this
# system to Google, and the door hands it to the guest's page. No client
# secret is used or kept, and no Google account is made for a guest.
GOOGLE_CLIENT_ID=

# ── Online check-in: DigiLocker, a fourth way in (D27-235 2.5) ──────────
# Switched OFF while any of these is empty: the guest's page offers nothing.
# From the DigiLocker partner registration through API Setu (the owner's,
# with the lawyer's answers). The redirect address is this website's
# /g-digilocker page, exactly as registered. The secret stays here only.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# ── Online check-in: guests' ID photos, encrypted, in Drive (D27-209) ────
# A photo of a guest's ID is never kept on this server: it is encrypted here
# with THAT HOTEL'S password and stored in Google Drive through its own
# workflow in the CRS's n8n (deploy/n8n/pms-id-photos-crs.json). Without the
# store, or without a hotel's password, that hotel's upload is not offered
# and the desk is told why. The steps: src/modules/online-checkin/
# OWNER-STEPS.md, Part 3.
#
#   ID_PHOTO_N8N_URL / ID_PHOTO_N8N_SECRET
#                        the photo workflow's Production URL and its OWN
#                        secret (not the sending workflow's)
#   ID_PHOTO_PASSWORD_<CODE>
#                        one per hotel, by its PMS code: ID_PHOTO_PASSWORD_5EL,
#                        ID_PHOTO_PASSWORD_AMR, ID_PHOTO_PASSWORD_GLM (D27-235).
#                        Letters and digits only, 24 or
#                        more; under 20, or with any other character in it,
#                        counts as NOT SET.
#   ⚠ SECRETS. The OWNER types them on the server only. Never here, a screen,
#     a test or a chat. A lost password means that hotel's photos cannot be
#     opened by anybody; a changed one cannot open the earlier photos.
ID_PHOTO_N8N_URL=
ID_PHOTO_N8N_SECRET=

# ── Rivals' prices for revenue management (D27-270) ─────────────────────
# Each nearby hotel's lowest public price per night, from Google Hotels
# through SerpApi (serpapi.com, Google Hotels API): 30 nights ahead, checked
# Mondays and Thursdays from 06:00, about 260 searches a month per hotel
# that has Settings → Modules and connections → Rivals' prices switched on.
# Empty, nothing is searched for any hotel.
#
#   SERPAPI_KEY   the owner's SerpApi account key. ⚠ A SECRET: the OWNER
#                 types it on the server only. Never in the repository, a
#                 screen, a test or a chat.
SERPAPI_KEY=

# ── Connection health's alert (D27-276) ─────────────────────────────────
# When a connection on Settings → Modules and connections → Connection
# health turns red (emails, WhatsApp, the CRS, Firebase, the backups,
# rivals' prices), the owner is told BY EMAIL, once, at most once an hour
# per connection, through the sending workflow (kind "health-alert";
# deploy/n8n/IMPORT.md). Never while emails themselves are not working.
# Empty: no alert emails; the page still shows every connection.
#
#   HEALTH_ALERT_EMAIL   the owner's own email address
HEALTH_ALERT_EMAIL=
