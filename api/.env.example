# ─────────────────────────────────────────────────────────────────
# The App API — copy to .env and fill in.
# ─────────────────────────────────────────────────────────────────

# pms_app owns ROWS and nothing else. Connecting as pms_migrate or
# postgres bypasses RLS and makes every isolation guarantee in the
# schema decorative. The health check fails loudly if this is wrong.
DATABASE_URL=postgres://pms_app:CHANGE_ME_app@127.0.0.1:55432/fidato

PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# The Firebase service account, as one line of JSON. THIS IS A SECRET,
# unlike the web config in src/lib/firebase.ts. Never commit it.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Development only: the x-dev-staff-id header names the caller, so the
# API can be exercised without a service account. The process REFUSES
# TO START with this set and NODE_ENV=production.
ALLOW_DEV_AUTH=1
