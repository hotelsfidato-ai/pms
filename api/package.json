{
  "name": "fidato-pms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The App API \u2014 verifies a Firebase ID token, sets app.user_id, and talks to Postgres as pms_app. MASTER.md \u00a75.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load-demo": "tsx scripts/load-demo.ts",
    "serve": "node scripts/free-port.mjs && tsx src/server.ts",
    "pos:outlet": "tsx scripts/pos-outlet.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "firebase-admin": "^13.0.2",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  }
}
