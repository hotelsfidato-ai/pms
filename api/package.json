{
  "name": "fidato-pms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The App API — verifies a Firebase ID token, sets app.user_id, and talks to Postgres as pms_app. MASTER.md §5.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "strip-check": "node scripts/strip-check.mjs",
    "test": "bash scripts/with-test-db.sh",
    "test:live": "tsx scripts/load-demo.ts && vitest run",
    "load-demo": "tsx scripts/load-demo.ts",
    "demo-history": "tsx scripts/demo-history.ts",
    "demo": "tsx scripts/load-demo.ts && tsx scripts/demo-history.ts",
    "reset": "node --experimental-strip-types scripts/reset-property.ts",
    "retire-staff": "node --experimental-strip-types scripts/retire-staff.ts",
    "serve": "node scripts/free-port.mjs && tsx src/server.ts",
    "pos:outlet": "node --experimental-strip-types scripts/pos-outlet.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "link-staff": "node --experimental-strip-types scripts/link-staff.ts",
    "test:only": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "exceljs": "4.4",
    "firebase-admin": "^13.0.2",
    "hono": "^4.6.14",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  }
}
