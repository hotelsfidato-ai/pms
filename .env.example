# Firebase — poms-fad05
#
# These values are NOT secrets. A Firebase web config identifies the
# project; it does not authorise anything. Access is controlled by
# Firebase Security Rules and by API key restrictions in the Google
# Cloud console. Google publishes them in their own sample code.
#
# They live here rather than in source so staging and production can
# differ without a code change.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local sign-in without a Firebase service account. Development only —
# the API refuses to start with its counterpart set in production.
VITE_ALLOW_DEV_AUTH=1
VITE_API_URL=http://localhost:8787
