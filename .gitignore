# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo
vitest.config.ts.timestamp-*

# Local environment. .env.example is committed as the template.
.env
.env.local
.env.*.local

# Backups are data, not source. db/verify-backup.sh proves the tooling;
# the dumps themselves belong wherever production keeps them.
db/backups/

# The preview build. Regenerate with `npm run build:preview` — a 1.9 MB
# generated file in git would make every rebuild a diff nobody can read.
dist-preview/
dist-artifact/

# Firebase CLI's local deploy cache — a hash of what was last uploaded.
# Machine-local, changes on every deploy, means nothing to anyone else.
.firebase/

# Agent skills installed with `npx skills add` — third-party, not ours
.agents/
.claude/skills/
skills-lock.json

# Agents' git worktrees — each a whole copy of the repo on its own branch.
.claude/worktrees/
