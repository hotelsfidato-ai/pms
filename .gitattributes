# Line endings, stated rather than left to each machine's core.autocrlf.
#
# A shell script with CRLF does not fail on Linux with a message about
# line endings — it fails with `$'\r': command not found`, which reads
# like a typo in the script. The deploy script is the one file where
# that would be discovered on a production box at the worst moment.
* text=auto

*.sh          text eol=lf
# A node script with a shebang: a fresh checkout on Windows made release.mjs
# CRLF and vitest would not load release.test.mjs in that copy (4 Oct).
*.mjs         text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
db/**/*.sql   text eol=lf

# Generated, and large. Never diffed.
*.json        text eol=lf
